@Gateway.Api_HostAddress = http://localhost:5100

### Register - Yeni kullanıcı kaydı
POST {{Gateway.Api_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "user@example.com",
  "password": "Test123!",
  "confirmPassword": "Test123!",
  "firstName": "John",
  "lastName": "Doe"
}

### Login - Kullanıcı girişi
POST {{Gateway.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin123!"
}

### Get Current User - Mevcut kullanıcı bilgisi (JWT gerekli)
# @name login
GET {{Gateway.Api_HostAddress}}/api/auth/me
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..00IFVsQPKhaV3jbj1gHt_S_Kufn0NDLCzLco6HxVhJA

### Refresh Token - Access token yenileme
POST {{Gateway.Api_HostAddress}}/api/auth/refresh-token
Content-Type: application/json

{
  "refreshToken": "your-refresh-token-here"
}

### Revoke Token - Logout (JWT gerekli)
POST {{Gateway.Api_HostAddress}}/api/auth/revoke-token
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "refreshToken": "your-refresh-token-here"
}

###################################
# ADMIN ENDPOINTS (Admin rolü gerekli)
###################################

### Admin Login
# Email: admin@example.com
# Password: Admin123!
POST {{Gateway.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "Admin123!"
}

### Get All Users (Admin only)
GET {{Gateway.Api_HostAddress}}/api/admin/users
Authorization: Bearer {{adminToken}}

### Get User by ID (Admin only)
GET {{Gateway.Api_HostAddress}}/api/admin/users/{{userId}}
Authorization: Bearer {{adminToken}}

### Get All Roles (Admin only)
GET {{Gateway.Api_HostAddress}}/api/admin/roles
Authorization: Bearer {{adminToken}}

### Create New Role (Admin only)
POST {{Gateway.Api_HostAddress}}/api/admin/roles
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "roleName": "Editor"
}

### Assign Role to User (Admin only)
POST {{Gateway.Api_HostAddress}}/api/admin/users/{{userId}}/roles/User
Authorization: Bearer {{adminToken}}

### Remove Role from User (Admin only)
DELETE {{Gateway.Api_HostAddress}}/api/admin/users/{{userId}}/roles/User
Authorization: Bearer {{adminToken}}

### Toggle User Status (Admin only)
PATCH {{Gateway.Api_HostAddress}}/api/admin/users/{{userId}}/status
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "isActive": false
}

### Delete Role (Admin only)
DELETE {{Gateway.Api_HostAddress}}/api/admin/roles/Editor
Authorization: Bearer {{adminToken}}

###################################
# PRODUCTS ENDPOINTS (Herkes okuyabilir, Admin yazabilir)
###################################

### Get All Products (Public)
GET {{Gateway.Api_HostAddress}}/api/products?pageNumber=1&pageSize=10
Accept: application/json

### Search Products (Public)
GET {{Gateway.Api_HostAddress}}/api/products/search?q=intel
Accept: application/json

### Get Product By ID (Public)
GET {{Gateway.Api_HostAddress}}/api/products/{{productId}}
Accept: application/json

### Create Product (Admin only)
POST {{Gateway.Api_HostAddress}}/api/products
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9NTRhvzRLEzmSXANhM_E9OBVK2_RRKO9fkXbT96oZDw

{
  "name": "Intel Core i7-14700K",
  "description": "20 çekirdekli (8P+12E), 28 thread",
  "sku": "CPU-INT-I7-14700K",
  "brand": "Intel",
  "model": "i7-14700K",
  "price": 18999.99,
  "stock": 20,
  "imageUrl": null,
  "specifications": "{\"cores\": 20, \"threads\": 28}",
  "categoryId": "9b52de26-bba7-419f-be66-023201b678de"
}

### Update Stock (Admin only)
PATCH {{Gateway.Api_HostAddress}}/api/products/{{productId}}/stock
Content-Type: application/json
Authorization: Bearer {{adminToken}}

{
  "quantity": -5
}

### Delete Product (Admin only)
DELETE {{Gateway.Api_HostAddress}}/api/products/5C25B1B7-55F8-4539-B42C-6FE2A79FC3C5
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..wwB_CqNVYVrls7fkqfbcitJM85hPAN36Q-qeNX1An9k

###################################
# CATEGORIES ENDPOINTS
###################################

### Get All Categories (Public)
GET {{Gateway.Api_HostAddress}}/api/categories
Accept: application/json

### Get Category Tree (Public)
GET {{Gateway.Api_HostAddress}}/api/categories/tree
Accept: application/json

### Create Category (Admin only)
POST {{Gateway.Api_HostAddress}}/api/categories
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..9NTRhvzRLEzmSXANhM_E9OBVK2_RRKO9fkXbT96oZDw

{
  "name": "Monitörler",
  "description": "Gaming ve profesyonel monitörler",
  "imageUrl": null,
  "parentCategoryId": null
}

###################################
# HEALTH CHECKS
###################################

### Gateway Health
GET {{Gateway.Api_HostAddress}}/health

### Gateway Liveness
GET {{Gateway.Api_HostAddress}}/health/live
